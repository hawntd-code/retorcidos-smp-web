{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, immutable" }]
    },
    {
      "source": "/(css|js)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ],
  "redirects": [
    { "source": "/overworld", "destination": "/", "permanent": false },
    { "source": "/nether", "destination": "/#llaves", "permanent": false },
    { "source": "/nether.html", "destination": "/#llaves", "permanent": false },
    { "source": "/end", "destination": "/#pase", "permanent": false },
    { "source": "/end.html", "destination": "/#pase", "permanent": false },
    { "source": "/entrar", "destination": "/#entrar", "permanent": false }
  ]
}
